import os, sqlite3, json, uuid, shutil
from flask import Flask, request, jsonify, send_from_directory
from PIL import Image

BASE  = os.path.dirname(os.path.abspath(__file__))
DB    = os.path.join(BASE, "garra.db")
UPL   = os.path.join(BASE, "uploads")
THB   = os.path.join(BASE, "thumbs")
os.makedirs(UPL, exist_ok=True)
os.makedirs(THB, exist_ok=True)

app = Flask(__name__)
app.config["MAX_CONTENT_LENGTH"] = 300 * 1024 * 1024

def db():
    c = sqlite3.connect(DB)
    c.row_factory = sqlite3.Row
    return c

def init_db():
    with db() as c:
        c.executescript("""
        CREATE TABLE IF NOT EXISTS meses(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ano INTEGER, mes INTEGER, label TEXT,
            criado_em TEXT DEFAULT(datetime('now','localtime')),
            UNIQUE(ano,mes));
        CREATE TABLE IF NOT EXISTS semanas(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            mes_id INTEGER REFERENCES meses(id) ON DELETE CASCADE,
            label TEXT, ordem INTEGER DEFAULT 0,
            criado_em TEXT DEFAULT(datetime('now','localtime')));
        CREATE TABLE IF NOT EXISTS pares(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            semana_id INTEGER REFERENCES semanas(id) ON DELETE CASCADE,
            codigo_a INTEGER, codigo_d INTEGER,
            local_nome TEXT DEFAULT '', data_label TEXT DEFAULT '',
            ordem INTEGER DEFAULT 0,
            criado_em TEXT DEFAULT(datetime('now','localtime')));
        CREATE TABLE IF NOT EXISTS fotos(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            par_id INTEGER REFERENCES pares(id) ON DELETE CASCADE,
            tipo TEXT, filename TEXT, original TEXT,
            ia_descricao TEXT DEFAULT '', ia_local TEXT DEFAULT '',
            criado_em TEXT DEFAULT(datetime('now','localtime')));
        CREATE TABLE IF NOT EXISTS cfg(chave TEXT PRIMARY KEY, valor TEXT);
        INSERT OR IGNORE INTO cfg VALUES('next_code','6018');
        """)

def next_code(c, n=2):
    r = c.execute("SELECT valor FROM cfg WHERE chave='next_code'").fetchone()
    v = int(r['valor'])
    c.execute("UPDATE cfg SET valor=? WHERE chave='next_code'",(v+n,))
    return v

@app.route('/')
def index():
    with open(os.path.join(BASE,'index.html'),encoding='utf-8') as f:
        return f.read()

@app.route('/uploads/<path:fn>')
def serve_upl(fn): return send_from_directory(UPL, fn)

@app.route('/thumbs/<path:fn>')
def serve_thb(fn): return send_from_directory(THB, fn)

@app.route('/api/meses', methods=['GET'])
def list_meses():
    with db() as c:
        rows = c.execute("""SELECT m.*,
            COUNT(DISTINCT s.id) total_semanas,
            COUNT(DISTINCT p.id) total_pares,
            COUNT(DISTINCT f.id) total_fotos
            FROM meses m
            LEFT JOIN semanas s ON s.mes_id=m.id
            LEFT JOIN pares p ON p.semana_id=s.id
            LEFT JOIN fotos f ON f.par_id=p.id
            GROUP BY m.id ORDER BY m.ano DESC,m.mes DESC""").fetchall()
    return jsonify([dict(r) for r in rows])

@app.route('/api/meses', methods=['POST'])
def create_mes():
    d = request.json
    with db() as c:
        try:
            c.execute("INSERT INTO meses(ano,mes,label) VALUES(?,?,?)",(d['ano'],d['mes'],d['label']))
            c.commit()
        except sqlite3.IntegrityError: pass
        r = c.execute("SELECT * FROM meses WHERE ano=? AND mes=?",(d['ano'],d['mes'])).fetchone()
    return jsonify(dict(r)), 201

@app.route('/api/meses/<int:mid>')
def get_mes(mid):
    with db() as c:
        m = c.execute("SELECT * FROM meses WHERE id=?",(mid,)).fetchone()
        if not m: return jsonify({'erro':'nao encontrado'}),404
        sems = c.execute("SELECT * FROM semanas WHERE mes_id=? ORDER BY ordem,id",(mid,)).fetchall()
        result = dict(m); result['semanas'] = []
        for s in sems:
            sd = dict(s); sd['pares'] = []
            pars = c.execute("SELECT * FROM pares WHERE semana_id=? ORDER BY ordem,id",(s['id'],)).fetchall()
            for p in pars:
                pd = dict(p)
                pd['fotos'] = [dict(f) for f in c.execute("SELECT * FROM fotos WHERE par_id=?",(p['id'],)).fetchall()]
                sd['pares'].append(pd)
            result['semanas'].append(sd)
    return jsonify(result)

@app.route('/api/semanas', methods=['POST'])
def create_sem():
    d = request.json
    with db() as c:
        c.execute("INSERT INTO semanas(mes_id,label,ordem) VALUES(?,?,?)",(d['mes_id'],d['label'],d.get('ordem',0)))
        c.commit()
        r = c.execute("SELECT * FROM semanas ORDER BY id DESC LIMIT 1").fetchone()
    return jsonify(dict(r)), 201

@app.route('/api/semanas/<int:sid>', methods=['PATCH'])
def patch_sem(sid):
    d = request.json
    with db() as c:
        if 'label' in d: c.execute("UPDATE semanas SET label=? WHERE id=?",(d['label'],sid))
        c.commit()
    return jsonify({'ok':True})

@app.route('/api/semanas/<int:sid>', methods=['DELETE'])
def del_sem(sid):
    with db() as c:
        for f in c.execute("SELECT f.filename FROM fotos f JOIN pares p ON f.par_id=p.id WHERE p.semana_id=?",(sid,)).fetchall():
            for d in [UPL,THB]:
                fp=os.path.join(d,f['filename'])
                if os.path.exists(fp): os.remove(fp)
        c.execute("DELETE FROM semanas WHERE id=?",(sid,)); c.commit()
    return jsonify({'ok':True})

@app.route('/api/pares', methods=['POST'])
def create_par():
    d = request.json
    with db() as c:
        code = next_code(c)
        c.execute("INSERT INTO pares(semana_id,codigo_a,codigo_d,local_nome,data_label,ordem) VALUES(?,?,?,?,?,?)",
            (d['semana_id'],code,code+1,d.get('local_nome',''),d.get('data_label',''),d.get('ordem',0)))
        c.commit()
        r = c.execute("SELECT * FROM pares ORDER BY id DESC LIMIT 1").fetchone()
    return jsonify(dict(r)), 201

@app.route('/api/pares/<int:pid>', methods=['PATCH'])
def patch_par(pid):
    d = request.json
    with db() as c:
        for col in ['local_nome','ordem','semana_id']:
            if col in d: c.execute(f"UPDATE pares SET {col}=? WHERE id=?",(d[col],pid))
        c.commit()
    return jsonify({'ok':True})

@app.route('/api/pares/<int:pid>', methods=['DELETE'])
def del_par(pid):
    with db() as c:
        for f in c.execute("SELECT filename FROM fotos WHERE par_id=?",(pid,)).fetchall():
            for d in [UPL,THB]:
                fp=os.path.join(d,f['filename'])
                if os.path.exists(fp): os.remove(fp)
        c.execute("DELETE FROM pares WHERE id=?",(pid,)); c.commit()
    return jsonify({'ok':True})

def save_file(file):
    ext = os.path.splitext(file.filename)[1].lower() or '.jpg'
    fn  = uuid.uuid4().hex + ext
    fp  = os.path.join(UPL, fn)
    tp  = os.path.join(THB, fn)
    file.save(fp)
    try:
        img = Image.open(fp); img.thumbnail((800,600),Image.LANCZOS); img.save(tp,quality=82)
    except: shutil.copy(fp,tp)
    return fn

@app.route('/api/fotos/avulsa', methods=['POST'])
def foto_avulsa():
    pid  = int(request.form['par_id'])
    tipo = request.form['tipo']
    file = request.files['foto']
    with db() as c:
        old = c.execute("SELECT filename FROM fotos WHERE par_id=? AND tipo=?",(pid,tipo)).fetchone()
        if old:
            for d in [UPL,THB]:
                fp=os.path.join(d,old['filename'])
                if os.path.exists(fp): os.remove(fp)
            c.execute("DELETE FROM fotos WHERE par_id=? AND tipo=?",(pid,tipo))
        fn = save_file(file)
        c.execute("INSERT INTO fotos(par_id,tipo,filename,original) VALUES(?,?,?,?)",(pid,tipo,fn,file.filename))
        c.commit()
        r = c.execute("SELECT * FROM fotos WHERE par_id=? AND tipo=?",(pid,tipo)).fetchone()
    return jsonify(dict(r)), 201

@app.route('/api/fotos/<int:fid>', methods=['DELETE'])
def del_foto(fid):
    with db() as c:
        f = c.execute("SELECT filename FROM fotos WHERE id=?",(fid,)).fetchone()
        if f:
            for d in [UPL,THB]:
                fp=os.path.join(d,f['filename'])
                if os.path.exists(fp): os.remove(fp)
            c.execute("DELETE FROM fotos WHERE id=?",(fid,)); c.commit()
    return jsonify({'ok':True})

@app.route('/api/config')
def get_cfg():
    with db() as c:
        rows = c.execute("SELECT * FROM cfg").fetchall()
    return jsonify({r['chave']:r['valor'] for r in rows})

if __name__ == '__main__':
    init_db()
    # ⚠️ Render injeta PORT via variável de ambiente
    port = int(os.environ.get('PORT', 5000))
    print(f"\n🟢 Garra Sistema de Fotos | Porta: {port}\n")
    app.run(host='0.0.0.0', port=port, debug=False)
